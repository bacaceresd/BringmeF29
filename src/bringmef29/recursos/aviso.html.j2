<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>F29 {{ periodo.etiqueta }} — {{ razon_social }}</title>
<style>{{ css | safe }}</style>
</head>
<body>
<div class="hoja">

  <header class="cabecera">
    <div>
      {% if logo_uri %}<img class="logo" src="{{ logo_uri }}" alt="{{ estudio.nombre }}">
      {% else %}<div class="estudio">{{ estudio.nombre }}</div>{% endif %}
    </div>
    <div class="periodo">F29 · {{ periodo.etiqueta }}</div>
  </header>

  <div class="quien">
    <div class="razon">{{ razon_social }}</div>
    <div class="rut">{{ rut }}{% if folio %} · Folio {{ folio }}{% endif %}</div>
  </div>

  {% if es_propuesta_del_sii %}
  <p class="advertencia">
    <strong>Atención:</strong> estas cifras vienen de la propuesta del SII, no de la
    declaración del contribuyente. No cobres con ellas sin revisarlas.
  </p>
  {% endif %}

  <table class="resumen">
    {% for grupo in resumen.grupos %}
    <tbody>
      <tr class="titulo-grupo"><th colspan="2">{{ grupo.titulo }}</th></tr>
      {% for linea in grupo.lineas %}
        {% if linea.separador %}
      <tr class="separador"><td colspan="2"></td></tr>
        {% else %}
      <tr class="{{ 'total' if linea.total }}{{ ' destacar' if linea.destacar }}">
        <td class="glosa">{% if linea.signo %}<span class="signo">({{ linea.signo }})</span>{% endif %}{{ linea.glosa }}</td>
        <td class="monto">{{ monto(linea.monto, parentesis=linea.parentesis) }}</td>
      </tr>
        {% endif %}
      {% endfor %}
      {% if grupo.nota %}
      <tr class="nota-grupo"><td colspan="2">{{ grupo.nota }}</td></tr>
      {% endif %}
    </tbody>
    {% endfor %}
  </table>

  <div class="total-final {{ 'sin-pago' if not resumen.hay_que_pagar }}">
    <div class="total-glosa">{{ resumen.total_glosa }}</div>
    <div class="total-monto">{{ monto(resumen.total_monto) }}</div>
  </div>

  {% if resumen.hay_que_pagar %}
  <p class="vencimiento">Fecha de vencimiento: <strong>{{ resumen.vencimiento_texto }}</strong></p>
  {% endif %}

  {% if resumen.descuadres %}
  <div class="descuadre">
    <strong>Revisa estas cifras:</strong>
    <ul>{% for d in resumen.descuadres %}<li>{{ d }}</li>{% endfor %}</ul>
  </div>
  {% endif %}

  {% if resumen.hay_que_pagar and pago.modo in ("transferencia", "ambos") and pago.numero_cuenta %}
  <div class="pago">
    <div class="pago-titulo">Para transferir</div>
    <table class="pago-tabla"><tbody>
      {% if pago.titular %}<tr><td>Titular</td><td>{{ pago.titular }}</td></tr>{% endif %}
      {% if pago.rut_titular %}<tr><td>RUT</td><td>{{ pago.rut_titular }}</td></tr>{% endif %}
      {% if pago.banco %}<tr><td>Banco</td><td>{{ pago.banco }}{% if pago.tipo_cuenta %} · {{ pago.tipo_cuenta }}{% endif %}</td></tr>{% endif %}
      <tr><td>Cuenta</td><td><strong>{{ pago.numero_cuenta }}</strong></td></tr>
      <tr><td>Glosa</td><td>F29 {{ periodo.codigo }} · {{ rut }}</td></tr>
    </tbody></table>
  </div>
  {% endif %}

  {% if resumen.hay_que_pagar and pago.modo in ("sii", "ambos") %}
  <p class="pago-sii">O paga directo en el SII: {{ pago.url_pago_sii }}</p>
  {% endif %}

  <footer class="pie">
    {{ estudio.nombre }}{% if estudio.correo %} · {{ estudio.correo }}{% endif %}{% if estudio.telefono %} · {{ estudio.telefono }}{% endif %}
    <span class="pie-proc">{{ procedencia_glosa }}</span>
  </footer>

</div>
</body>
</html>
