<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>F29 {{ periodo.etiqueta }}</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    width: 1080px; height: 1080px;
    font-family: "Helvetica Neue", Helvetica, Arial, "Liberation Sans", sans-serif;
    background: #0b2136;
    color: #fff;
    display: flex; flex-direction: column;
    -webkit-print-color-adjust: exact;
  }
  .cabecera {
    padding: 52px 64px 0; display: flex; align-items: center;
    justify-content: space-between; gap: 24px;
  }
  .logo { max-height: 76px; max-width: 300px; object-fit: contain; }
  .estudio { font-size: 30px; font-weight: 700; letter-spacing: .3px; }
  .chip {
    background: rgba(255,255,255,.12); border-radius: 999px;
    padding: 12px 26px; font-size: 24px; letter-spacing: 1px; white-space: nowrap;
  }
  .cuerpo { flex: 1; padding: 44px 64px; display: flex; flex-direction: column; justify-content: center; }
  .rotulo { font-size: 26px; letter-spacing: 4px; text-transform: uppercase; color: #8fc0e8; }
  .contribuyente { font-size: 52px; font-weight: 700; line-height: 1.15; margin-top: 10px; }
  .rut { font-size: 30px; color: #b8cde0; margin-top: 8px; }
  .caja {
    margin-top: 44px; background: {{ "#f6b93b" if hay_que_pagar else "#2e9e6b" }};
    color: #11263a; border-radius: 26px; padding: 40px 48px;
  }
  .caja-rotulo { font-size: 26px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; opacity: .8; }
  .caja-monto { font-size: 108px; font-weight: 800; line-height: 1.05; letter-spacing: -3px; }
  .caja-plazo { font-size: 28px; margin-top: 10px; }
  .detalle { margin-top: 38px; display: flex; gap: 20px; }
  .detalle > div {
    flex: 1; background: rgba(255,255,255,.08); border-radius: 18px; padding: 24px 26px;
  }
  .detalle .k { font-size: 21px; letter-spacing: 2px; text-transform: uppercase; color: #8fc0e8; }
  .detalle .v { font-size: 34px; font-weight: 700; margin-top: 6px; word-break: break-word; }
  .pie {
    padding: 30px 64px 46px; font-size: 24px; color: #9ab6cd;
    border-top: 1px solid rgba(255,255,255,.12);
  }
</style>
</head>
<body>
  <div class="cabecera">
    {% if logo_uri %}<img class="logo" src="{{ logo_uri }}" alt="">{% else %}
    <div class="estudio">{{ estudio.nombre }}</div>{% endif %}
    <div class="chip">F29 · {{ periodo.etiqueta }}</div>
  </div>

  <div class="cuerpo">
    <div class="rotulo">Declaración presentada en el SII</div>
    <div class="contribuyente">{{ razon_social }}</div>
    <div class="rut">{{ rut }}</div>

    <div class="caja">
      <div class="caja-rotulo">{{ "Total a pagar" if hay_que_pagar else "Sin pago asociado" }}</div>
      <div class="caja-monto">{{ monto_a_pagar }}</div>
      <div class="caja-plazo">
        {% if hay_que_pagar %}Vence el {{ vencimiento }}
        {% elif remanente %}Remanente de crédito fiscal: {{ remanente }}
        {% else %}No hay impuesto que enterar este período{% endif %}
      </div>
    </div>

    <div class="detalle">
      <div><div class="k">Folio SII</div><div class="v">{{ folio or "—" }}</div></div>
      <div><div class="k">Período</div><div class="v">{{ periodo.codigo }}</div></div>
      {% if estado %}<div><div class="k">Estado</div><div class="v">{{ estado }}</div></div>{% endif %}
    </div>
  </div>

  <div class="pie">
    El detalle completo va en el PDF adjunto{% if estudio.nombre %} · {{ estudio.nombre }}{% endif %}
  </div>
</body>
</html>
