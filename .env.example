# Copia a .env y complétalo. .env está en .gitignore.

# --- Clave maestra del almacén cifrado -------------------------------------
# Genérala con:  bringmef29 clave generar-maestra
# Si la pierdes, hay que volver a guardar todas las claves tributarias.
BRINGMEF29_MASTER_KEY=

# --- Claves tributarias del SII --------------------------------------------
# Alternativa al almacén cifrado: una variable por cliente, con el alias en
# mayúsculas y los guiones convertidos en guión bajo.
# BRINGMEF29_CLAVE_ACME=
# BRINGMEF29_CLAVE_FERRETERIA_SUR=

# --- Correo saliente --------------------------------------------------------
# Gmail y Microsoft 365 exigen una contraseña de aplicación, no la del correo.
BRINGMEF29_SMTP_CLAVE=

# --- WhatsApp (sólo si usas proveedor twilio o meta) ------------------------
# BRINGMEF29_TWILIO_TOKEN=
# BRINGMEF29_META_TOKEN=

# --- Opcional ---------------------------------------------------------------
# Ruta a un Chromium propio si no usas el de Playwright.
# BRINGMEF29_CHROMIUM=
# Ruta del archivo de configuración si no es config/clientes.yml
# BRINGMEF29_CONFIG=
